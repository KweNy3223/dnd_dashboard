{
  "name": "dnd_dashboard",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron-vite dev",
    "build:win": "electron-vite build && electron-builder --win",
    "build": "electron-vite build"
  },
  "build": {
    "appId": "com.dnd.dashboard",
    "productName": "DnD Dashboard",
    "asar": true,
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "out/",
        "to": "out/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-rnd": "^10.5.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}